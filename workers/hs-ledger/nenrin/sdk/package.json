{
  "name": "nenrin-verify",
  "version": "0.4.4",
  "description": "Zero-dependency, consumer-runnable verifiers for NENRIN evidence: a provenance bundle (nenrin_verify.mjs), a two-party agreement record (nenrin-agreement-verify) and a TSUGI recovery chain with its random witness draw (tsugi_verify.mjs). The same reports as the Python package nenrin-verify. Verify yourself, offline, with no trust in the operator.",
  "type": "module",
  "main": "nenrin_verify.mjs",
  "exports": {
    ".": "./nenrin_verify.mjs",
    "./tsugi": "./tsugi_verify.mjs",
    "./agreement": "./agreement_verify.mjs"
  },
  "bin": {
    "nenrin-verify": "nenrin_verify.mjs",
    "tsugi-verify": "tsugi_verify.mjs",
    "nenrin-agreement-verify": "agreement_cli.mjs"
  },
  "files": [
    "nenrin_verify.mjs",
    "tsugi_verify.mjs",
    "agreement_verify.mjs",
    "agreement_canonical.mjs",
    "key_succession.mjs",
    "agreement_cli.mjs",
    "SDK.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "a2a",
    "provenance",
    "verification",
    "did-key",
    "ed25519",
    "nenrin",
    "agent",
    "evidence",
    "bitcoin",
    "trust",
    "horizon-shield",
    "recovery",
    "tsugi",
    "witness",
    "random-draw",
    "commit-reveal",
    "agreement",
    "key-succession"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogasurfproject-jpg/horizon-shield.git",
    "directory": "workers/hs-ledger/nenrin/sdk"
  },
  "homepage": "https://github.com/ogasurfproject-jpg/horizon-shield/tree/main/workers/hs-ledger/nenrin/sdk",
  "bugs": {
    "url": "https://github.com/ogasurfproject-jpg/horizon-shield/issues"
  },
  "author": "The HORIZONs Co., Ltd.",
  "license": "MIT"
}
