// hs-phone: HORIZON SHIELD の電話の受付。Twilio の番号にかかった電話を、Claude が日本語か英語で受ける。
// 鍵は secret(TWILIO_AUTH_TOKEN、ANTHROPIC_API_KEY、WS_TOKEN_KEY、HUMAN_PHONE、RESEND_API_KEY、LINE_CHANNEL_TOKEN、LINE_USER_ID)。値はここに書かない。
// 手順は DEPLOY_TOshi.md。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hs-phone",
	"main": "src/worker.js",
	"compatibility_date": "2026-06-28",
	"account_id": "c15ff64aba400e541853dec1fbe5e76a",
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"kv_namespaces": [
		{ "binding": "PHONE_KV", "id": "<PHONE_KV_ID>" }
	],
	// 相場・見積もりの照合・赤旗・加盟店探しは HORIZON SHIELD の MCP(hs-mcp)を binding で呼ぶ。金額はそこからしか言わない
	"services": [
		{ "binding": "HS_MCP", "service": "hs-mcp" }
	],
	"vars": {
		// 番号ごとの最初の言語。番号を買ったら入れる。例: {"+81120xxxxxx":"ja","+8150xxxxxxxx":"en"}
		"NUMBER_LANG": "{}",
		"VOICE_MODELS": "claude-haiku-4-5-20251001,claude-sonnet-4-6",
		// 1 本の通話の上限(秒)、1 本の中の往復の上限、1 日の AI の通話の上限(分)、同じ番号から 1 日にかけられる回数
		"MAX_CALL_SEC": "600",
		"MAX_TURNS": "30",
		"DAILY_MIN_CAP": "120",
		"PER_CALLER_DAILY": "5",
		// 担当者に回す時間(日本時間)と曜日(0 が日曜、6 が土曜)。外れていたら伝言だけ
		"HUMAN_HOURS": "09:00-18:00",
		"HUMAN_DAYS": "1,2,3,4,5",
		"RETENTION_DAYS": "90",
		"NOTIFY_EMAIL": "contact@the-horizons-innovation.com"
	}
}
