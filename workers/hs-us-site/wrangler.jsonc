{
  // hs-us-site: the U.S. site of HORIZON SHIELD at https://horizonshield.dev/ (2026-10-09).
  // The Japanese site stays on shield.the-horizons-innovation.com (GitHub Pages). The two do not share pages.
  // Static files only (public/). GitHub Pages never publishes this folder: its build removes workers/.
  // custom_domain: true makes wrangler create the DNS record for the apex of horizonshield.dev on deploy.
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "hs-us-site",
  "account_id": "c15ff64aba400e541853dec1fbe5e76a",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "horizonshield.dev", "custom_domain": true }
  ]
}
